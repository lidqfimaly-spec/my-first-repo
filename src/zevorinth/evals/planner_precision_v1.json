      "goal": "创建 exact.txt，内容严格为“Hello from Zevorinth”。",
      "scripted_output": {
        "classification": "plan",
        "operation": "write_text_artifact",
        "artifact_path": "exact.txt",
        "content": "Hello from Zevorinth",
        "missing_fields": [],
        "clarification_questions": [],
        "reason": null
      },
      "expected_classification": "planned",
      "expected_plan_parameters": {
