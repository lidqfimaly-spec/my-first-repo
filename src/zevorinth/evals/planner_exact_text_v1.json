{
  "version": "planner-exact-text-v1",
  "retroactively_applicable": false,
  "description": "Explicit semantic, format-constrained, and codepoint-exact write precision.",
  "modes": {
    "semantic": {
      "comparison": "none",
      "normalizes_text": false
    },
    "format_constrained": {
      "comparison": "declared_format",
      "normalizes_text": false
    },
    "exact_text": {
      "comparison": "codepoint_exact",
      "normalizes_text": false
    }
  },
  "content_formats": {
    "plain_text": {
      "rule": "non-empty text"
    },
    "markdown": {
      "rule": "first non-whitespace token is an ATX heading"
    },
    "json_object": {
      "rule": "content parses as a JSON object"
    }
  },
  "cases": [
    {
      "id": "exact_match",
      "category": "exact_text",
      "goal": "创建 exact.txt，内容严格为“任务完成”。",
      "trusted_parameters": {
        "precision_mode": "exact_text",
        "expected_text": "任务完成"
      },
      "scripted_output": {
        "classification": "plan",
        "operation": "write_text_artifact",
        "artifact_path": "exact.txt",
        "content": "任务完成",
        "missing_fields": [],
        "clarification_questions": [],
        "reason": null
      },
      "expected_classification": "planned",
      "must_not_plan": false
    },
    {
      "id": "exact_punctuation_preserved",
      "category": "exact_text",
      "goal": "创建 exact.txt，内容严格为“任务完成。”。",
      "trusted_parameters": {
        "precision_mode": "exact_text",
        "expected_text": "任务完成。"
      },
      "scripted_output": {
        "classification": "plan",
        "operation": "write_text_artifact",
        "artifact_path": "exact.txt",
